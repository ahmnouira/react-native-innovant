{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "react-native-innovant": ["../src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "../node_modules"]
}
