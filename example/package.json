{
  "name": "react-native-innovant-example",
  "version": "0.4.0",
  "private": true,
  "description": "Example app for react-native-innovant",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-innovant": "file:..",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@react-native/typescript-config": "^0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "babel-jest": "^30.5.1",
    "eslint": "^8.19.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "^7.0.2"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?@?react-native|@react-native-community|@react-navigation|react-native-snackbar-component)"
    ]
  }
}
