{
  "name": "react-native-innovant",
  "version": "0.4.1",
  "description": "A modern React Native UI library with reusable, production-ready components.",
  "license": "MIT",
  "author": {
    "name": "Ahmed Nouira",
    "email": "ahmnouira@gmail.com",
    "url": "https://github.com/ahmnouira"
  },
  "homepage": "https://github.com/ahmnouira/react-native-innovant",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmnouira/react-native-innovant.git"
  },
  "bugs": {
    "url": "https://github.com/ahmnouira/react-native-innovant/issues"
  },
  "readme": "https://github.com/ahmnouira/react-native-innovant#readme",
  "keywords": [
    "react-native",
    "react-native-library",
    "react-native-ui",
    "react-native-components",
    "react-native-ui-library",
    "react-native-design-system",
    "react-native-typescript",
    "typescript",
    "mobile-ui",
    "mobile-components",
    "ui-kit",
    "design-system",
    "ios",
    "android",
    "expo",
    "cross-platform"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:update": "jest -u",
    "test:ci": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "rimraf dist && tsc",
    "changelog": "auto-changelog -p"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.13.0",
    "react-native-raw-bottom-sheet": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/eslint-config": "^0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@react-native/typescript-config": "^0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.0.0",
    "babel-jest": "^30.5.1",
    "eslint": "^8.19.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}